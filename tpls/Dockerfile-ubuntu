FROM ubuntu:24.04

RUN apt-get update && apt-get install -y git build-essential m4 zlib1g-dev libx11-dev gfortran pkg-config autoconf python3-dev python3-pip vim tmux nano gdb valgrind libssl-dev curl && \
    apt-get autoremove -y && apt-get clean && rm -rf /var/lib/apt/lists/*

ARG JOBS=8

COPY . /opt/goma

RUN PYTHONUNBUFFERED=1 /opt/goma/install-tpls.py --cc=gcc --cxx=g++ --fc=gfortran --build-shared --download-dir=/tmp/downloads -j ${JOBS} --extract-dir=/tmp/extract /opt/goma-libs && \
    rm -rf /opt/goma /tmp/downloads /tmp/extract /opt/goma-libs/logs

RUN cp /opt/goma-libs/config.sh /etc/profile.d/goma-libs.sh

RUN { \
      echo '#!/usr/bin/env bash' \
      && echo ". /opt/goma-libs/config.sh" \
      && echo 'exec "$@"'; \
    } > /entrypoint.sh \
&& chmod a+x /entrypoint.sh

ENV OMPI_MCA_btl "^vader"
ENV OMPI_MCA_btl_base_warn_component_unuse "0"
ENV OMPI_ALLOW_RUN_AS_ROOT 1
ENV OMPI_ALLOW_RUN_AS_ROOT_CONFIRM 1
WORKDIR /opt/workdir

ENTRYPOINT [ "/entrypoint.sh" ]
CMD [ "/bin/bash" ]

