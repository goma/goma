FROM rockylinux:9

RUN dnf update -y && \
    dnf install -y git patch gcc-toolset-13 m4 make bzip2 tar zlib-devel openssl-devel pkgconfig python3-devel findutils && \
    dnf clean all && rm -rf /var/cache/dnf

ARG JOBS=8

COPY . /opt/goma

RUN . /opt/rh/gcc-toolset-13/enable && \
 PYTHONUNBUFFERED=1 /opt/goma/install-tpls.py --cc=gcc --cxx=g++ --fc=gfortran --netlib-blas --build-shared --download-dir=/tmp/downloads --install-complex-petsc -j ${JOBS} --extract-dir=/tmp/extract /opt/goma-libs && \
    rm -rf /opt/goma /tmp/downloads /tmp/extract /opt/goma-libs/logs

RUN echo ". /opt/rh/gcc-toolset-13/enable" > /etc/profile.d/goma-libs.sh
RUN cat /opt/goma-libs/config.sh >> /etc/profile.d/goma-libs.sh

RUN { \
      echo '#!/usr/bin/env bash' \
      && echo ". /opt/rh/gcc-toolset-13/enable" \
      && echo ". /opt/goma-libs/config.sh" \
      && echo 'exec "$@"'; \
    } > /entrypoint.sh \
&& chmod a+x /entrypoint.sh

ENV OMPI_MCA_btl "^vader"
ENV OMPI_MCA_btl_base_warn_component_unuse "0"
ENV OMPI_ALLOW_RUN_AS_ROOT 1
ENV OMPI_ALLOW_RUN_AS_ROOT_CONFIRM 1
WORKDIR /opt/workdir

ENTRYPOINT [ "/entrypoint.sh" ]
CMD [ "/bin/bash" ]
